[Desktop Entry]
Type=Application
Name=Easy Player
GenericName=Audio Player
Comment=Play songs and whole folders
Exec=easy-player %F
Icon=com.hawwwran.EasyPlayer
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;playlist;mp3;flac;
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/wav;audio/x-wav;audio/vnd.wave;audio/mp4;audio/x-m4a;audio/m4a;audio/aac;audio/x-aac;audio/x-aiff;audio/aiff;audio/x-matroska;
StartupNotify=true
StartupWMClass=com.hawwwran.EasyPlayer
